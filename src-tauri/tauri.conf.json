{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.2.0",
  "identifier": "app.raven.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Raven Browser",
    "copyright": "Raven Browser",
    "shortDescription": "Raven: hızlı, az RAM kullanan tarayıcı",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Turkish",
          "English"
        ]
      }
    }
  }
}
